<mujoco model="2DOF_RP_Robot">

    <compiler angle="radian" autolimits="true"/>

    <option timestep="0.002" gravity="0 0 -9.81"/>

    <worldbody>

        <!-- Ground -->
        <geom name="ground"
              type="plane"
              size="2 2 0.1"
              rgba="0.75 0.75 0.75 1"/>

        <!-- Lighting -->
        <light name="main_light"
               pos="0 -1 2"
               dir="0 0 -1"
               diffuse="0.8 0.8 0.8"/>

        <!-- Fixed Base Flange -->
        <body name="base">

            <geom name="base_flange"
                  type="cylinder"
                  pos="0 0 0.015"
                  size="0.15 0.015"
                  rgba="0.65 0.67 0.70 1"
                  contype="0"
                  conaffinity="0"/>

            <!-- Vertical Column -->
            <body name="column" pos="0 0 0.03">

                <geom name="vertical_column"
                      type="cylinder"
                      pos="0 0 0.06"
                      size="0.055 0.06"
                      rgba="0.65 0.67 0.70 1"
                      contype="0"
                      conaffinity="0"/>

                <!-- Revolute Assembly -->
                <body name="rotating_arm" pos="0 0 0.12">

                    <joint name="joint1"
                           type="hinge"
                           axis="0 0 1"
                           range="0 6.283185307"
                           limited="true"
                           damping="2.0"/>

                    <!-- Rotating Shoulder -->
                    <geom name="shoulder"
                          type="cylinder"
                          pos="0 0 0"
                          size="0.075 0.045"
                          rgba="0.25 0.35 0.55 1"
                          contype="0"
                          conaffinity="0"/>

                    <!-- Fixed Outer Arm Housing -->
                    <geom name="outer_housing"
                          type="box"
                          pos="0.15 0 0"
                          size="0.15 0.04 0.035"
                          rgba="0.70 0.72 0.75 1"
                          contype="0"
                          conaffinity="0"/>

                    <!-- Prismatic Assembly -->
                    <body name="sliding_arm">

                        <joint name="joint2"
                               type="slide"
                               axis="1 0 0"
                               range="0 0.40"
                               limited="true"
                               damping="10.0"/>

                        <!-- Inner Sliding Arm -->
                        <geom name="inner_slider"
                              type="box"
                              pos="-0.07 0 0"
                              size="0.12 0.023 0.018"
                              rgba="0.85 0.45 0.20 1"
                              contype="0"
                              conaffinity="0"/>

                        <!-- TCP -->
                        <site name="tcp"
                              pos="0 0 0"
                              size="0.012"
                              rgba="0 1 0 1"/>

                    </body>

                </body>
            </body>
        </body>

    </worldbody>

    <!-- Position Actuators -->
    <actuator>

        <position name="joint1_motor"
                  joint="joint1"
                  kp="100"
                  kv="10"
                  ctrlrange="0 6.283185307"
                  forcerange="-50 50"/>

        <position name="joint2_motor"
                  joint="joint2"
                  kp="500"
                  kv="50"
                  ctrlrange="0 0.40"
                  forcerange="-100 100"/>

    </actuator>

</mujoco>